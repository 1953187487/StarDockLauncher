<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/md_surface_variant"/>
            <corners android:radius="@dimen/md_radius_sm"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/md_surface"/>
            <corners android:radius="@dimen/md_radius_sm"/>
            <stroke android:width="0.5dp" android:color="@color/md_divider"/>
        </shape>
    </item>
</selector>
