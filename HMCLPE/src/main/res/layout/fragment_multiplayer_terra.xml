<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:background="@drawable/launcher_view_light_gray"
            android:text="@string/multiplayer_terra_intro"
            android:textSize="14sp"
            android:textColor="@color/colorPureBlack"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:padding="14dp"
            android:background="@drawable/launcher_view_light_gray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/multiplayer_terra_create"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPureBlack"/>

            <TextView
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击下方按钮启动游戏并自动开启局域网开关，生成邀请码复制到剪贴板"
                android:textSize="12sp"
                android:textColor="@color/colorPureBlack"/>

            <Button
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btn_terra_create"
                android:text="@string/multiplayer_terra_create"
                android:textSize="14sp"/>

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:padding="14dp"
            android:background="@drawable/launcher_view_light_gray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/multiplayer_terra_join"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPureBlack"/>

            <TextView
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="输入房主提供的邀请码，加入房间"
                android:textSize="12sp"
                android:textColor="@color/colorPureBlack"/>

            <EditText
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/et_terra_invite_code"
                android:hint="粘贴邀请码"
                android:textSize="14sp"
                android:inputType="text"/>

            <Button
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btn_terra_join"
                android:text="@string/multiplayer_terra_join"
                android:textSize="14sp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
