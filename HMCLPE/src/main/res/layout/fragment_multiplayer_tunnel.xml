<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:background="@drawable/launcher_view_light_gray"
            android:text="@string/multiplayer_tunnel_intro"
            android:textSize="14sp"
            android:textColor="@color/colorPureBlack"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:padding="14dp"
            android:background="@drawable/launcher_view_light_gray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/multiplayer_tunnel_import"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPureBlack"/>

            <TextView
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_tunnel_path"
                android:text="@string/multiplayer_no_tunnel"
                android:textSize="12sp"
                android:textColor="@color/colorPureBlack"/>

            <Button
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btn_tunnel_import"
                android:text="@string/multiplayer_tunnel_import"
                android:textSize="14sp"/>

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:padding="14dp"
            android:background="@drawable/launcher_view_light_gray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/multiplayer_tunnel_enable"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPureBlack"/>

            <TextView
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击下方按钮启动游戏，自动读取局域网 IP 并通过内网穿透转换为连接 ID，复制到剪贴板"
                android:textSize="12sp"
                android:textColor="@color/colorPureBlack"/>

            <Button
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btn_tunnel_enable"
                android:text="@string/multiplayer_tunnel_enable"
                android:textSize="14sp"/>

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:padding="14dp"
            android:background="@drawable/launcher_view_light_gray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/multiplayer_tunnel_join"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPureBlack"/>

            <TextView
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="输入房主提供的连接 ID，加入房间"
                android:textSize="12sp"
                android:textColor="@color/colorPureBlack"/>

            <EditText
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/et_tunnel_id"
                android:hint="粘贴连接 ID"
                android:textSize="14sp"
                android:inputType="text"/>

            <Button
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btn_tunnel_join"
                android:text="@string/multiplayer_tunnel_join"
                android:textSize="14sp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
