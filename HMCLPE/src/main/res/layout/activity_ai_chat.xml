<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ai_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F20F1419"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <View
                android:id="@+id/ai_drawer_handle"
                android:layout_width="6dp"
                android:layout_height="36dp"
                android:background="#4DFFFFFF"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/ai_drawer_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AI 智能助手"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ai_connection_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已连接"
                android:textSize="11sp"
                android:layout_marginEnd="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ai_provider_badge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="服务商：StarDock 默认 · auto"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/ai_provider_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_btn_provider"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="服务商"
                android:textSize="12sp"
                android:minHeight="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_btn_history"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="历史"
                android:textSize="12sp"
                android:minHeight="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_btn_settings"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="设置"
                android:textSize="12sp"
                android:minHeight="40dp" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/ai_quick_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/ai_quick_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/ai_message_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#1AFFFFFF"
            android:fadeScrollbars="false">

            <LinearLayout
                android:id="@+id/ai_message_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </ScrollView>

        <FrameLayout
            android:id="@+id/ai_typing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:padding="6dp">

            <TextView
                android:id="@+id/ai_typing_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A0FFFFFF"
                android:textSize="11sp"
                android:text="正在连接 AI..." />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_attach"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@android:drawable/ic_input_add"
                android:contentDescription="附加" />

            <EditText
                android:id="@+id/ai_input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:hint="和「消息小溪」聊天..."
                android:textColorHint="#80FFFFFF"
                android:textColor="#FFFFFF"
                android:background="#2AFFFFFF"
                android:padding="10dp"
                android:textSize="13sp"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine"
                android:maxLines="3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_send"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="64dp"
                android:text="发送"
                android:textSize="12sp"
                android:enabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_stop"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:minWidth="48dp"
                android:text="停"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
