<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sd_surface_dim"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/home_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sd_surface"
        android:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/home_toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/sd_surface"
            app:titleTextColor="@color/sd_on_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/sd_logo_tile" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="StarDockLauncher"
                        android:textColor="@color/sd_on_surface"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/home_toolbar_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="主页"
                        android:textColor="@color/sd_on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_btn_multiplayer"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconTint="@color/sd_on_secondary_container"
                    app:iconSize="20dp"
                    android:contentDescription="联机" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_btn_ai"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    app:icon="@drawable/ic_ai_assistant"
                    app:iconTint="@color/sd_on_primary_container"
                    app:iconSize="20dp"
                    android:contentDescription="AI 助手" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_btn_min"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    app:icon="@android:drawable/ic_menu_view"
                    app:iconTint="@color/sd_on_tertiary_container"
                    app:iconSize="20dp"
                    android:contentDescription="最小化" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_btn_close"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    app:icon="@android:drawable/ic_menu_close_clear_cancel"
                    app:iconTint="@color/sd_on_error"
                    app:iconSize="20dp"
                    android:contentDescription="关闭" />

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:dividerColor="@color/sd_outline_variant" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:layout_marginBottom="80dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/home_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/sd_surface"
        app:itemIconTint="@color/sd_nav_item_color"
        app:itemTextColor="@color/sd_nav_item_color"
        app:itemRippleColor="@color/sd_secondary_container"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/sd_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
