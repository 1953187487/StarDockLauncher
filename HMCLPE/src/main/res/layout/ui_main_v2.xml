<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ui_main_v2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sd_surface_dim">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sd_surface"
        android:elevation="0dp"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/sd_surface"
            app:titleTextColor="@color/sd_on_surface"
            app:titleCentered="false"
            app:contentInsetStartWithNavigation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/sd_logo_tile" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="StarDockLauncher"
                        android:textColor="@color/sd_on_surface"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/topbar_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="主页"
                        android:textColor="@color/sd_on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/topbar_ai_btn"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:icon="@drawable/ic_ai_assistant"
                    app:iconTint="@color/sd_on_primary_container"
                    app:iconSize="20dp"
                    android:contentDescription="AI 助手" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/topbar_back_btn"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:icon="@android:drawable/ic_menu_revert"
                    app:iconTint="@color/sd_on_secondary_container"
                    app:iconSize="20dp"
                    android:visibility="gone"
                    android:contentDescription="返回" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/topbar_close_btn"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    app:icon="@android:drawable/ic_menu_close_clear_cancel"
                    app:iconTint="@color/sd_on_tertiary_container"
                    app:iconSize="20dp"
                    android:contentDescription="关闭" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/topbar_min_btn"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    app:icon="@android:drawable/ic_menu_view"
                    app:iconTint="@color/sd_on_secondary_container"
                    app:iconSize="20dp"
                    android:contentDescription="最小化" />

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:dividerColor="@color/sd_outline_variant" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:layout_marginBottom="80dp" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_play"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="96dp"
        android:text="启动游戏"
        android:textColor="@color/sd_on_primary"
        android:textStyle="bold"
        app:icon="@drawable/ic_baseline_play_arrow_white"
        app:iconTint="@color/sd_on_primary"
        app:backgroundTint="@color/sd_primary"
        app:elevation="6dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/sd_surface"
        app:itemIconTint="@color/sd_nav_item_color"
        app:itemTextColor="@color/sd_nav_item_color"
        app:itemRippleColor="@color/sd_secondary_container"
        app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/sd_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
