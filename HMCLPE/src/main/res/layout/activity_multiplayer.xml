<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_ui_background"
    android:padding="16dp">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/multiplayer_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/colorLinkBlueDark"
        app:tabSelectedTextColor="@color/colorLinkBlueDark"
        app:tabTextColor="@color/colorPureBlack"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/multiplayer_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
