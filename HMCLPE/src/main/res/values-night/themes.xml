<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HelloMinecraftLauncherPocketEdition" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorPrimaryDark">@color/md_primary_variant</item>
        <item name="colorAccent">@color/md_accent</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="android:windowBackground">@color/md_background</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/md_primary_variant</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/md_primary_variant</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:popupMenuStyle">@style/MenuStyle</item>
    </style>

    <style name="ModernText">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ModernText.Button">
        <item name="android:textColor">@color/md_on_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ModernText.Title">
        <item name="android:textColor">@color/md_on_background</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="ModernText.Subtitle">
        <item name="android:textColor">@color/md_on_surface_medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ModernText.Body">
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="MenuStyle" parent="Widget.AppCompat.PopupMenu">
        <item name="dropdownListPreferredItemHeight">42dp</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/MenuTextStyle</item>
        <item name="android:textAppearanceLargePopupMenu">@style/MenuTextStyle</item>
    </style>

    <style name="MenuTextStyle">
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
