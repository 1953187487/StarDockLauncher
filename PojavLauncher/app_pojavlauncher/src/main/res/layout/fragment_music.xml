<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/background_top_bar"
        android:paddingHorizontal="@dimen/_12sdp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/music_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/music_import_button"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_download"
            android:contentDescription="@string/music_import" />
    </LinearLayout>

    <ListView
        android:id="@+id/music_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider_soft"
        android:dividerHeight="1dp"
        android:listSelector="@drawable/background_nav_button"
        android:padding="@dimen/_12sdp" />

    <!-- Playback control bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background_nav_bar"
        android:padding="@dimen/_12sdp">

        <TextView
            android:id="@+id/music_now_playing_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_11ssp" />

        <TextView
            android:id="@+id/music_now_playing_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_13ssp"
            android:maxLines="1"
            android:ellipsize="end" />

        <SeekBar
            android:id="@+id/music_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/music_prev_button"
                android:layout_width="@dimen/_56sdp"
                android:layout_height="@dimen/_56sdp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_media_previous" />

            <ImageButton
                android:id="@+id/music_play_button"
                android:layout_width="@dimen/_64sdp"
                android:layout_height="@dimen/_64sdp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_media_play" />

            <ImageButton
                android:id="@+id/music_next_button"
                android:layout_width="@dimen/_56sdp"
                android:layout_height="@dimen/_56sdp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_media_next" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
