<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_main_v4"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <!-- 左菜单 -->
    <LinearLayout
        android:id="@+id/main_menu_column"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background_top_bar"
        android:padding="@dimen/_24sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/main_play_column"
        app:layout_constraintHorizontal_weight="6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 账号卡 -->
                <LinearLayout
                    android:id="@+id/main_account_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/background_card_elevated"
                    android:padding="@dimen/_20sdp">

                    <ImageView
                        android:id="@+id/main_account_avatar"
                        android:layout_width="@dimen/_56sdp"
                        android:layout_height="@dimen/_56sdp"
                        android:src="@drawable/avatar_steve" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_14sdp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/main_account_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未登录"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/_16ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/main_account_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:text="点击登录"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/_12ssp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="@dimen/_20sdp" />

                <!-- 关于 -->
                <LinearLayout android:id="@+id/main_menu_about" style="@style/StarDockMenuCard">
                    <ImageView style="@style/StarDockMenuCardIcon" android:src="@drawable/ic_setting_misc" />
                    <TextView style="@style/StarDockMenuCardLabel" android:text="关于应用" />
                </LinearLayout>

                <!-- 分享日志 -->
                <LinearLayout android:id="@+id/main_menu_share_logs" style="@style/StarDockMenuCard">
                    <ImageView style="@style/StarDockMenuCardIcon" android:src="@drawable/ic_send" />
                    <TextView style="@style/StarDockMenuCardLabel" android:text="分享日志" />
                </LinearLayout>

                <!-- 打开目录 -->
                <LinearLayout android:id="@+id/main_menu_open_dir" style="@style/StarDockMenuCard">
                    <ImageView style="@style/StarDockMenuCardIcon" android:src="@drawable/ic_folder" />
                    <TextView style="@style/StarDockMenuCardLabel" android:text="打开游戏目录" />
                </LinearLayout>

                <!-- 安装 jar -->
                <LinearLayout android:id="@+id/main_menu_install_jar" style="@style/StarDockMenuCard">
                    <ImageView style="@style/StarDockMenuCardIcon" android:src="@drawable/ic_menu_install_jar" />
                    <TextView style="@style/StarDockMenuCardLabel" android:text="安装 Jar / Mod" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 右 play 区域 -->
    <LinearLayout
        android:id="@+id/main_play_column"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/_28sdp"
        android:background="@color/background_app"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="4"
        app:layout_constraintStart_toEndOf="@+id/main_menu_column"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 版本卡 -->
        <LinearLayout
            android:id="@+id/main_version_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/background_card_elevated"
            android:padding="@dimen/_24sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:src="@drawable/ic_edit_profile" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前版本"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_11ssp" />

                    <TextView
                        android:id="@+id/main_version_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:text="未选择版本"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_20ssp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/main_manage_btn"
                    style="@style/StarDockPrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_44sdp"
                    android:text="管理" />
            </LinearLayout>

            <TextView
                android:id="@+id/main_version_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 启动游戏大按钮（完全自绘，不依赖 MineButton） -->
        <Button
            android:id="@+id/main_play_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_80sdp"
            android:background="@drawable/background_button_play"
            android:text="启动游戏"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_20ssp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:elevation="0dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
