<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/background_top_bar"
        android:paddingHorizontal="@dimen/_12sdp">

        <ImageButton
            android:id="@+id/third_party_back_button"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="@string/login_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_6sdp"
            android:text="@string/login_third_party"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_20sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_third_party"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_18sdp"
                android:text="输入第三方 Minecraft 验证服务器的根地址，系统将自动识别登录接口。"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_11ssp"
                android:lineSpacingExtra="2dp" />

            <EditText
                android:id="@+id/third_party_url_input"
                style="@style/StarDockInput"
                android:layout_marginBottom="@dimen/_12sdp"
                android:hint="@string/login_third_party_url_hint"
                android:inputType="textUri" />

            <TextView
                android:id="@+id/third_party_url_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_10sdp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_11ssp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/third_party_url_next"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_56sdp"
                android:text="@string/login_third_party_url_next" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
