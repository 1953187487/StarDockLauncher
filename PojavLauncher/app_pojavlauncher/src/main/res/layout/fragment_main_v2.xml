<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_main_v2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <!-- 顶部：启动游戏 + 管理版本按钮 + 标题 -->
    <LinearLayout
        android:id="@+id/main_top"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/background_top_bar"
        android:padding="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/main_account_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="@string/sd_offline"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>

        <com.kdt.mcgui.MineButton
            android:id="@+id/main_play_button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_56sdp"
            android:minWidth="@dimen/_180sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:textAllCaps="true"
            android:text="@string/sd_launch_title" />

        <Button
            android:id="@+id/main_manage_versions_button"
            style="@style/StarDockPrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_56sdp"
            android:text="@string/sd_manage_versions" />
    </LinearLayout>

    <!-- 下方：已下载版本列表 -->
    <LinearLayout
        android:id="@+id/versions_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:orientation="vertical"
        android:background="@drawable/background_card"
        android:padding="@dimen/_16sdp"
        app:layout_constraintBottom_toTopOf="@id/account_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_top">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sd_versions"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versions_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="@string/sd_no_versions"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12ssp" />

        <ListView
            android:id="@+id/versions_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/_8sdp"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@drawable/background_nav_button" />
    </LinearLayout>

    <!-- 右下：账号登录面板 -->
    <LinearLayout
        android:id="@+id/account_panel"
        android:layout_width="@dimen/_220sdp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/background_card"
        android:padding="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/account_avatar"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@drawable/background_card"
            android:src="@drawable/ic_menu_settings" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/account_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sd_account_login"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/account_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sd_offline"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>

        <com.kdt.mcgui.mcAccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_40sdp"
            android:dropDownWidth="@dimen/_220sdp"
            android:dropDownVerticalOffset="@dimen/_44sdp"
            android:visibility="gone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
