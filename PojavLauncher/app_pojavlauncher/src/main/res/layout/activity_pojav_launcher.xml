<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/background_app">

    <!-- 左侧导航 -->
    <LinearLayout
        android:id="@+id/left_nav_v2"
        android:layout_width="@dimen/_88sdp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background_nav_bar"
        android:paddingVertical="@dimen/_12sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="@dimen/_12sdp">

            <ImageView
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:src="@drawable/ic_launcher_foreground" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_launch"
            style="@style/StarDockNavRail">
            <ImageView style="@style/StarDockNavRailIcon" android:src="@drawable/ic_menu_home" />
            <TextView style="@style/StarDockNavRailLabel" android:text="@string/nav_launch" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_download"
            style="@style/StarDockNavRail">
            <ImageView style="@style/StarDockNavRailIcon" android:src="@drawable/ic_download" />
            <TextView style="@style/StarDockNavRailLabel" android:text="@string/nav_download" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_multiplayer"
            style="@style/StarDockNavRail">
            <ImageView style="@style/StarDockNavRailIcon" android:src="@drawable/ic_multiplayer" />
            <TextView style="@style/StarDockNavRailLabel" android:text="@string/nav_multiplayer" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_keybinding"
            style="@style/StarDockNavRail">
            <ImageView style="@style/StarDockNavRailIcon" android:src="@drawable/ic_menu_custom_controls" />
            <TextView style="@style/StarDockNavRailLabel" android:text="@string/sd_nav_keybinding" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/nav_settings"
            style="@style/StarDockNavRail">
            <ImageView style="@style/StarDockNavRailIcon" android:src="@drawable/ic_menu_settings" />
            <TextView style="@style/StarDockNavRailLabel" android:text="@string/nav_settings" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右侧内容 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
