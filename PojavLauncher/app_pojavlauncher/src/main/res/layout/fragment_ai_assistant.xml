<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/background_top_bar"
        android:paddingHorizontal="@dimen/_12sdp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_ai"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/ai_keybind_button"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_menu_custom_controls"
            android:contentDescription="@string/ai_keybind_title" />

        <ImageButton
            android:id="@+id/ai_clear_button"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_menu_delete_forever"
            android:contentDescription="清空会话" />

        <ImageButton
            android:id="@+id/ai_config_button"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_menu_settings"
            android:contentDescription="@string/ai_config_title" />
    </LinearLayout>

    <ListView
        android:id="@+id/ai_chat_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:padding="@dimen/_12sdp"
        android:scrollbars="none" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/background_nav_bar"
        android:padding="@dimen/_10sdp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/ai_input"
            style="@style/StarDockInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/_8sdp"
            android:hint="@string/ai_input_hint" />

        <Button
            android:id="@+id/ai_send_button"
            style="@style/StarDockPrimaryButton"
            android:layout_height="match_parent"
            android:drawableStart="@drawable/ic_send"
            android:drawablePadding="@dimen/_4sdp"
            android:longClickable="true"
            android:text="@string/ai_send" />
    </LinearLayout>

</LinearLayout>
