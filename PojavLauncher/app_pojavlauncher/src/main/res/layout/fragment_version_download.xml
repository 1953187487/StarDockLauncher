<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background_top_bar"
        android:padding="@dimen/_24sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="下载中心"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_22ssp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="BMCLAPI 镜像 · 搜索 / 下载 / 管理 Minecraft Java 版版本"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

            <Button
                android:id="@+id/vd_check_update_btn"
                style="@style/StarDockPrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_44sdp"
                android:text="检查更新" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_20sdp">

        <EditText
            android:id="@+id/vd_search_box"
            android:layout_width="0dp"
            android:layout_height="@dimen/_48sdp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/_12sdp"
            android:background="@drawable/background_input"
            android:hint="@string/sd_v6_search_hint"
            android:paddingHorizontal="@dimen/_16sdp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="@dimen/_14ssp"
            android:inputType="text"
            android:imeOptions="actionSearch" />

        <Button
            android:id="@+id/vd_search_btn"
            style="@style/StarDockPrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_48sdp"
            android:text="搜索" />

        <Button
            android:id="@+id/vd_refresh_btn"
            style="@style/StarDockPrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_48sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:text="刷新" />
    </LinearLayout>

    <TextView
        android:id="@+id/vd_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_24sdp"
        android:paddingBottom="@dimen/_8sdp"
        android:text="正在从 BMCLAPI 加载版本列表…"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_12ssp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingBottom="@dimen/_20sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已下载版本"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vd_installed_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:padding="@dimen/_16sdp"
                android:background="@drawable/background_card_elevated"
                android:text="尚未下载任何版本"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_12ssp" />

            <LinearLayout
                android:id="@+id/vd_installed_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_20sdp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="搜索结果"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vd_search_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:padding="@dimen/_16sdp"
                android:background="@drawable/background_card_elevated"
                android:text="搜索或刷新获取版本列表"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_12ssp" />

            <LinearLayout
                android:id="@+id/vd_search_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
