<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or not? -->
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/background_top_bar</item>
        <item name="android:navigationBarColor">@color/background_nav_bar</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:windowBackground">@color/background_app</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_66sdp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <!-- StarDock module: shared card / nav styles -->
    <style name="StarDockCard" parent="@android:style/Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/background_card</item>
        <item name="android:padding">@dimen/_16sdp</item>
    </style>

    <style name="StarDockNavButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/background_nav_button</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">@dimen/_4sdp</item>
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:textColor">@color/nav_inactive</item>
    </style>

    <style name="StarDockInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_44sdp</item>
        <item name="android:background">@drawable/background_input</item>
        <item name="android:paddingHorizontal">@dimen/_12sdp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="StarDockPrimaryButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/_44sdp</item>
        <item name="android:background">@drawable/background_button_primary</item>
        <item name="android:paddingHorizontal">@dimen/_24sdp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StarDockSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StarDockNavRail">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginVertical">@dimen/_3sdp</item>
        <item name="android:layout_marginHorizontal">@dimen/_6sdp</item>
        <item name="android:padding">@dimen/_8sdp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/background_nav_rail</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="StarDockNavRailIcon">
        <item name="android:layout_width">@dimen/_26sdp</item>
        <item name="android:layout_height">@dimen/_26sdp</item>
        <item name="android:tint">@color/nav_inactive</item>
    </style>

    <style name="StarDockNavRailLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_4sdp</item>
        <item name="android:textColor">@color/nav_inactive</item>
        <item name="android:textSize">@dimen/_10ssp</item>
    </style>

    <!-- v0.0.6 菜单卡片 -->
    <style name="StarDockMenuCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_12sdp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/background_item</item>
        <item name="android:padding">@dimen/_16sdp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="StarDockMenuCardIcon">
        <item name="android:layout_width">@dimen/_28sdp</item>
        <item name="android:layout_height">@dimen/_28sdp</item>
        <item name="android:layout_marginEnd">@dimen/_16sdp</item>
        <item name="android:tint">@color/brand_primary</item>
    </style>

    <style name="StarDockMenuCardLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/_14ssp</item>
    </style>
</resources>
